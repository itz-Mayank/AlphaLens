# ==============================================================================
# AlphaLens — Environment Configuration
# Copy this file to .env and adjust values. Never commit the real .env file.
# ==============================================================================

# --- Environment ---
ENVIRONMENT=development          # development | test | production
DEMO_MODE=true                   # true = use MockProvider + seeded dataset, no external API keys needed

# --- Database ---
POSTGRES_USER=alphalens
POSTGRES_PASSWORD=changeme_local_dev_only
POSTGRES_DB=alphalens
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://alphalens:changeme_local_dev_only@postgres:5432/alphalens

# --- Redis (cache, Celery broker + result backend, pub/sub) ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Auth / JWT ---
JWT_SECRET=changeme_generate_a_long_random_secret_for_local_dev
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
REFRESH_COOKIE_NAME=alphalens_refresh_token
# true in production (requires HTTPS) — false locally so cookies work over http
COOKIE_SECURE=false
# Used to build the password-reset link sent to users
FRONTEND_BASE_URL=http://localhost:5173

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- External data providers (legacy Phase 3/6 keys — superseded by the
# Phase 10 provider-ecosystem settings below, which select and configure
# providers explicitly rather than gating on DEMO_MODE) ---
MARKET_DATA_API_KEY=
NEWS_API_KEY=

# --- Provider ecosystem (Phase 10) — see docs/decisions.md's Phase 10
# provider-ecosystem ADR and docs/architecture.md's "Provider ecosystem"
# section for the full evaluation behind each selection. Each category is
# selected independently and defaults to a safe, credential-free value —
# the app runs fully in Demo Mode with everything below left blank.
DATA_ENVIRONMENT=demo             # demo | production — informational; each *_PROVIDER setting below is authoritative
MARKET_DATA_PROVIDER=demo         # demo | twelvedata
NEWS_PROVIDER=demo                # demo (no real provider is currently integrated — see the ADR)
FUNDAMENTALS_PROVIDER=none        # none | sec_edgar
MACRO_PROVIDER=none               # none | fred

# Twelve Data (market data) — free tier explicitly forbids commercial use/
# redistribution (verified against twelvedata.com/terms, Section 2.3);
# fine for this project's own demo/personal deployment only.
TWELVE_DATA_API_KEY=

# SEC EDGAR (fundamentals) — needs NO API key, only an identifying
# User-Agent with a real contact address per SEC's fair-access policy.
SEC_EDGAR_USER_AGENT=AlphaLens research your-email@example.com

# FRED (macro) — free, public-domain, but requires a free registered key:
# https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# --- ML / Model storage ---
MODEL_STORAGE_PATH=/data/model_artifacts
FEATURE_SET_VERSION=fs_v1
# Registry produced by ml/scripts/run_real_experiment.py; /ml is where
# docker-compose bind-mounts the sibling ml/ project directory.
ML_REGISTRY_PATH=/ml/experiments/registry.json

# --- Reports ---
REPORT_STORAGE_PATH=/data/reports

# --- Research agent (Phase 8) — see docs/ml-pipeline.md "Research agent" ---
# No default: unset means the agent is unavailable (a clean 503), never a
# silent fallback. claude-haiku-4-5 is the deliberately cost-conscious
# default dev model.
LLM_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOOL_ITERATIONS=6
LLM_MAX_TOOL_CALLS_PER_TURN=4

# --- Research agent, multi-provider (Phase 8.5) — see docs/architecture.md
# "Research agent flow" and docs/decisions.md's provider-abstraction ADR.
# LLM_PROVIDER selects which provider `get_llm_provider()` builds
# ("anthropic" | "groq" | "gemini"); default "anthropic" keeps every
# pre-8.5 deployment unchanged. Only the selected provider's own key is
# required — server-side only, never sent to the frontend.
LLM_PROVIDER=anthropic
GROQ_API_KEY=
GROQ_LLM_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
GEMINI_LLM_MODEL=gemini-flash-latest

# --- Frontend (build-time, safe to expose) ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_BASE_URL=ws://localhost:8000

# --- Observability (optional) ---
LOG_LEVEL=INFO
SENTRY_DSN=
